# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# ENTSO-E Transparency Platform security token (free). Used from Day 4 on as a
# second, independent price source to cross-check Energy-Charts.
# How to get it: register at https://transparency.entsoe.eu, then e-mail
# transparency@entsoe.eu with the subject "Restful API access" and your
# account e-mail; afterwards generate the token under "My Account Settings".
ENTSOE_API_KEY=
